local busy = false

action.MouseButton1Click:Connect(function()

    if busy then return end
    busy = true

    -- Roblox Studio LocalScripts cannot directly
    -- access the system clipboard.
    -- This notification does not claim that copying
    -- has happened.

    toast.Text = "✓ WEBSITE LINK READY"

    tween(toast, {
        Position = UDim2.new(0.5, 0, 1, -65),
        BackgroundTransparency = 0,
        TextTransparency = 0
    }, 0.3)

    task.wait(2)

    tween(toast, {
        Position = UDim2.new(0.5, 0, 1, 30),
        BackgroundTransparency = 1,
        TextTransparency = 1
    }, 0.3)

    task.wait(0.35)
    busy = false
end)

